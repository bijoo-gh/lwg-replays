{
  "manifest_version": 3,
  "name": "LWG Replay Loader",
  "version": "0.1.3",
  "description": "Open a Little War Game replay straight from a link: littlewargame.com/play/#replay=<url-to-json>",
  "icons": {},
  "content_scripts": [
    {
      "matches": ["https://littlewargame.com/play/*"],
      "js": ["content-game.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bijoo-gh.github.io/lwg-replays/*"],
      "js": ["content-site.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lwg-loader.js"],
      "matches": ["https://littlewargame.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lwg-replay-loader@lwg-replays",
      "strict_min_version": "115.0"
    }
  }
}
